{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "c",
      "camelcase": "C",
      "scope": "source.c",
      "path": ".",
      "file-types": ["c", "h"],
      "injection-regex": "^(c|h)$",
      "external-files": [
        "src/pragma.h",
        "src/identifier.h",
        "src/keywords.h",
        "src/functionMacro.h",
        "src/conditionalMacro.h",
        "src/emptyDirectives.h",
        "src/gnuRawString.h"
      ]
    }
  ],
  "metadata": {
    "version": "0.24.2",
    "license": "MIT",
    "description": "C grammar for tree-sitter",
    "authors": [
      {
        "name": "WillBooster Inc."
      }
    ],
    "links": {
      "repository": "https://github.com/WillBooster/tree-sitter-c"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
